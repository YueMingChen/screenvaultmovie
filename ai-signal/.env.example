# 翻译服务：mymemory（免费、无需 Key）| openai（兼容 DeepSeek/OpenAI）| none
TRANSLATION_PROVIDER=mymemory

# 每次采集最多翻译多少条新文章
TRANSLATION_MAX_ITEMS=24

# 如果使用 OpenAI 兼容接口，填写以下配置
TRANSLATION_BASE_URL=https://api.deepseek.com
TRANSLATION_MODEL=deepseek-chat
TRANSLATION_API_KEY=

# 可选：限制每个来源的文章数
MAX_ITEMS_PER_SOURCE=40
